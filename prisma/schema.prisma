generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Condition {
  Baru
  Bekas
}

enum FuelType {
  Bensin
  Diesel
  Listrik
  Hybrid
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  password        String
  role            String    @default("user") 
  profilePicture  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]
}

model CartItem {
  id          String   @id @default(uuid())
  userId      String
  productId   String
  quantity    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model WishlistItem {
  id          String   @id @default(uuid())
  userId      String
  productId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Product {
  id              String    @id @default(uuid())
  name            String
  description     String
  longDescription String
  price           Float
  discountPrice   Float? 
  images          String[]
  category        String
  fuelType        FuelType?
  condition       Condition @default(Baru)
  mileage         Int?
  popularity      Int       @default(80)
  releaseDate     DateTime
  isFeatured      Boolean   @default(false)
  isPromo         Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]
}

model Banner {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  image       String
  link        String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Sales {
  id                 String    @id @default(uuid())
  employeeId         String    @unique // NIK / Nomor Induk Karyawan ERP
  name               String
  phone              String
  email              String    @unique
  title              String    @default("Automotive Sales Consultant")
  status             String    @default("ACTIVE") // "ACTIVE" | "INACTIVE"
  assignedLeadsCount Int       @default(0)
  lastAssignedAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  orders             Order[]
}

model Order {
  id                 String    @id // Format SPK e.g. "SPK-20260905-XXXX"
  customerName       String
  customerNik        String?
  customerPhone      String
  customerEmail      String
  customerCity       String
  customerAddress    String
  paymentMethod      String    @default("CASH") // "CASH" | "KREDIT"
  notes              String?
  items              Json      // Rincian unit mobil yang dipesan
  totalAmount        Float
  status             String    @default("BARU") // BARU, DIHUBUNGI, DEAL, SELESAI, BATAL
  assignedSalesId    String?
  assignedSales      Sales?    @relation(fields: [assignedSalesId], references: [id], onDelete: SetNull)
  forwardedToSalesAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

